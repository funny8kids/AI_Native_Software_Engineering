# Editor directories and files
.idea
.vscode
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Compiled binary addons
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache
.npm

# Optional REPL history
.node_repl_history

# Environment variables
.env
.env.local
.env.*.local
# Python bytecode from guard scripts
__pycache__/
*.pyc

# 回归矩阵的取证日志（scripts/matrix_*.sh 的默认落点）。
# 搬进仓库是为了扛住重启——/tmp 是 tmpfs，上一轮的取证被一次重启整个清掉过；
# 不进版本库是因为它是本机取证，不是书的组成部分，且每轮都换目录名会无限堆积。
logs/
